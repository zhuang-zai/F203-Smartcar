   84          /**
   85           * @brief 计算循迹偏差
   86           * 使用差比和算法计算车辆偏离中心线的程度
   87           * 公式：( (左感+左感) - (右感+右感) ) / (总电感 + 补偿值) * 100
   88           * @return int 归一化后的偏差值，范围 -100 到 100
   89           */
   90          int Calculate_Deviation(void) 
   91          {
   92   1          // 获取电感ADC数组指针 (假设顺序为: 左外, 左内, 中, 右内, 右外)
   93   1          int* adc_values = GetInductance();
   94   1          
   95   1          // 计算左右两侧电感值的差值 (分子)，反映偏向哪一侧
   96   1          int eleSub = (adc_values[0] + adc_values[1]) - (adc_values[3] + adc_values[4]);
   97   1          
   98   1          // 计算所有电感值的总和 (分母)，+10是为了防止分母为0导致除零错误
   99   1          // 使用“差比和”可以消除由于速度变化导致的磁场强度整体变化影响
  100   1          int eleAdd = adc_values[0] + adc_values[1] + adc_values[2] + adc_values[3] + adc_values[4] + 10;
  101   1        
  102   1          // 计算归一化偏差值
  103   1          float eleValue = (float)eleSub / (float)eleAdd * 100.0f;
  104   1        
  105   1          static uint16 off_track_timer = 0;   // 丢线持续时间计数器
  106   1        
  107   1          if(eleAdd < 20.0)
  108   1          {
  109   2            off_track_timer++;
  110   2            if(off_track_timer >= 250)
  111   2            {
  112   3              stop_flag = 1;
  113   3            }
  114   2            
  115   2          }
  116   1          else
  117   1          {
  118   2            off_track_timer = 0;
  119   2            stop_flag = 0;
  120   2          }
  121   1          
  122   1          // 限幅处理：将偏差值限制在 -100 到 100 之间
C251 COMPILER V5.60.0,  chassis                                                            24/05/26  22:48:37  PAGE 3   

  123   1          if(eleValue > 100.0f) eleValue = 100.0f;
