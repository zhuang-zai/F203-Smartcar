   83   1          direction_pid = PID_GetController(PID_DIRECTION);
   84   1          
   85   1          // 3. 计算PID输出
   86   1          if (direction_pid != NULL) 
   87   1          {
   88   2              // 1. 获取当前的循迹偏差
   89   2              chassis.current_deviation = Calculate_Deviation();
   90   2              // 级联位置/方向PID计算，目标值设为0（即赛道中心）
   91   2              direction_output = PID_CascadePosition((PID_TypeDef *)direction_pid, chassis.current_deviation, 0
             -);
   92   2          } else {
   93   2              // 如果PID未初始化，输出为0
   94   2              direction_output = 0;
   95   2          }
   96   1          //读取当前的偏航角速度
   97   1          actual_yaw_rate = Get_Yaw_Rate();
   98   1          // 4. 差速分配
   99   1          // 左轮速度 = 基础速度 + 转向修正
  100   1          chassis.left_speed = chassis.target_speed + direction_output;
  101   1          // 右轮速度 = 基础速度 - 转向修正
  102   1          chassis.right_speed = chassis.target_speed - direction_output;
  103   1          
  104   1          // 5. 执行电机控制
  105   1          Motor_Control(chassis.left_speed, chassis.right_speed);
  106   1      }


