  101   1          int eleAdd = adc_values[0] + adc_values[1] + adc_values[2] + adc_values[3] + adc_values[4] + 10;
  102   1        
  103   1          // 计算归一化偏差值
  104   1          float eleValue = (float)eleSub / (float)eleAdd * 100.0f;
  105   1        
  106   1          static uint16 off_track_timer = 0;   // 丢线持续时间计数器
  107   1          if(stop_flag == 1) return 0;
  108   1        
  109   1          if(eleAdd < 20.0)
  110   1          {
  111   2            off_track_timer++;
  112   2            if(off_track_timer >= 250) stop_flag = 1;
  113   2          }
  114   1          else
  115   1          {
  116   2            off_track_timer = 0;
  117   2          }
  118   1          
  119   1          // 限幅处理：将偏差值限制在 -100 到 100 之间
  120   1          if(eleValue > 100.0f) eleValue = 100.0f;
