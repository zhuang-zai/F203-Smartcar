   82          /**
   83           * @brief 计算循迹偏差
   84           * 使用差比和算法计算车辆偏离中心线的程度
   85           * 公式：( (左感+左感) - (右感+右感) ) / (总电感 + 补偿值) * 100
   86           * @return int 归一化后的偏差值，范围 -100 到 100
   87           */
   88          int Calculate_Deviation(void) 
   89          {
   90   1          // 获取电感ADC数组指针 (假设顺序为: 左外, 左内, 中, 右内, 右外)
   91   1          int* adc_values = GetInductance();
   92   1          
   93   1          // 计算左右两侧电感值的差值 (分子)，反映偏向哪一侧
   94   1          int eleSub = (adc_values[0] + adc_values[1]) - (adc_values[3] + adc_values[4]);
   95   1          
   96   1          // 计算所有电感值的总和 (分母)，+10是为了防止分母为0导致除零错误
   97   1          // 使用“差比和”可以消除由于速度变化导致的磁场强度整体变化影响
   98   1          int eleAdd = adc_values[0] + adc_values[1] + adc_values[2] + adc_values[3] + adc_values[4] + 10;
   99   1        
  100   1          // 计算归一化偏差值
  101   1          float eleValue = (float)eleSub / (float)eleAdd * 100.0f;
  102   1        
  103   1          static uint16 off_track_timer = 0;   // 丢线持续时间计数器
  104   1          if(stop_flag == 1) return 0;
  105   1        
  106   1          if(eleAdd < 20.0)
  107   1          {
  108   2            off_track_timer++;
  109   2            if(off_track_timer >= 250) stop_flag = 1;
  110   2          }
  111   1          else
  112   1          {
  113   2            off_track_timer = 0;
  114   2          }
  115   1          
  116   1          // 限幅处理：将偏差值限制在 -100 到 100 之间
  117   1          if(eleValue > 100.0f) eleValue = 100.0f;
  118   1          else if(eleValue < -100.0f) eleValue = -100.0f;
  119   1      
  120   1          // 转换为整型返回给控制层
  121   1          return (int)(eleValue);
  122   1      }
