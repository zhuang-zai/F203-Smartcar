   47          /**
   48           * @brief 按键发车等待函数 (V2.0 安全倒计时版)
   49           * @note 必须按下并松开 GO 按键，随后延时 1 秒才会发车
   50           */
   51          void Wait_For_Start(void)
   52          {
   53   1          // 初始化 P2_0 为上拉输入模式
   54   1          gpio_init_pin(P2_0, GPIO_Mode_IPU);
   55   1          
C251 COMPILER V5.60.0,  init                                                               26/05/26  21:00:38  PAGE 2   

   56   1          // 等待按键按下
   57   1          while (gpio_read_pin(P2_0) == 1);
   58   1          
   59   1          // 按下消抖
