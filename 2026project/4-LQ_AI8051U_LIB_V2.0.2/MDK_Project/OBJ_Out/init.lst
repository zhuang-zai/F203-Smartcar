  145          void Key_Tuning_Task(void)
  146          {
  147   1          u8 rent_key = ADKey_Scan(); 
  148   1          
  149   1          if (rent_key != KEY_NONE)   
  150   1          {
  151   2              // ?? 修改点1：获取【方向环】（索引为2）真实的参数
  152   2              const PID_TypeDef* pid = PID_GetController(2);
  153   2              float temp_kp = pid->Kp;
  154   2              float temp_kd = pid->Kd;
  155   2      
  156   2              switch (rent_key)
  157   2              {
  158   3                  case KEY_PRESS:   // 1. 中间按压键：在 Kp 和 Kd 之间切换 (0:Kp -> 2:Kd -> 回到0)
  159   3                      if (selected_param == 0) selected_param = 2;
  160   3                      else selected_param = 0;
  161   3                      break;
  162   3      
  163   3                  case KEY_UP:      // 2. 向上键：参数增加
  164   3                      if (selected_param == 0)      temp_kp += tune_step;
  165   3                      else                          temp_kd += tune_step;
  166   3                      break;
  167   3      
  168   3                  case KEY_DOWN:    // 3. 向下键：参数减少
  169   3                      if (selected_param == 0)      temp_kp -= tune_step;
  170   3                      else                          temp_kd -= tune_step;
  171   3                      
  172   3                      // P和D绝对不能为负数
  173   3                      if (temp_kp < 0.0f) temp_kp = 0.0f;
  174   3                      if (temp_kd < 0.0f) temp_kd = 0.0f;
  175   3                      break;
  176   3      
  177   3                  case KEY_LEFT:    // 4. 向左键：高精度微调
  178   3                      // ?? 修改点2：方向环的 P 通常在 10~50 级别，微调步长给 1.0
  179   3                      tune_step = 1.0f;
  180   3                      break;
  181   3      
  182   3                  case KEY_RIGHT:   // 5. 向右键：大幅度粗调
  183   3                      // ?? 修改点3：粗调步长给 10.0
  184   3                      tune_step = 10.0f;
