  250          // 将当前 PID 参数保存到 EEPROM，实现掉电不丢失
  251          // 在每次 VOFA+ 调参后调用，覆盖 EEPROM 扇区 0
  252          // 受 eeprom_enabled 标志位控制：为 0 时直接返回不执行任何操作
  253          uint8 Debug_SaveToEEPROM(void)
  254          {
  255   1          EEPROM_PID_Data eep;
  256   1          uint16 idx;
  257   1      
  258   1          // EEPROM 功能关闭时直接返回，不执行擦除和写入操作
  259   1          if(eeprom_enabled == 0) return 0;
  260   1      
