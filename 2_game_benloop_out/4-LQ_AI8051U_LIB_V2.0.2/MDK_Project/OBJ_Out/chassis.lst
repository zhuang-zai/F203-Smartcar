  349          void Dynamic_Yaw_Test_Task(void)
  350          {
  351   1          static uint16 time_tick = 0;   // 时间计数器
  352   1          static uint8 current_stage = 0; // 当前所处的测试阶段
  353   1      
  354   1          // 1. 如果车子处于急停/未发车状态，重置测试进度
  355   1          if (stop_flag == 1) 
